# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
env/

# ---------------------------------------------------------------------------
# Runtime state, logs, data, backups
# ---------------------------------------------------------------------------
logs/
transcripts/

# Any data/ directory, at any depth (sector-intel/data/ included).
**/data/
# ... except the repo-root one, which is opened just far enough to track the
# router gold label set. That set is the only independent record of what
# correct routing looks like, it is small, and every routing accuracy number is
# measured against it. Losing it means losing the ability to tell whether a
# change to the signal maps helped or hurt. Everything else under data/ stays
# ignored.
!/data/
/data/*
!/data/router_labels.jsonl

# Speech models (VOSK small is ~70 MB, large ~1.8 GB) - fetched with
# scripts/download_vosk_model.ps1|sh, never committed.
models/vosk/*
!models/vosk/.gitkeep
video_output/
media_input/
*.bak
*.PRE-*.bak

# ---------------------------------------------------------------------------
# Node / front-end
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

my-video/*.mp4
sector-intel/logs/

# secrets - never commit (n8n deploy webhook credential, stray debug log)
#
# The rule below was correct and still let the secret out. On 29 Aug 2026 the
# credential file was ignored exactly as intended, and then the folder holding
# it was zipped and the ZIP was committed to a public repo. Ignoring a file does
# nothing about an archive of that file. Deploy bundles are build artefacts and
# are regenerable, so none of them are tracked.
**/remote_deploy_credentials.json
deploy/*.zip
webhook_test2.log
deploy/webhook_audit.log
